PORT=5000
MONGO_URI=mongodb://localhost:27017/smartq

JWT_ACCESS_SECRET=replace_with_secure_value

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=app_password
SMTP_FROM=SmartQ <you@example.com>
SMTP_ENABLE_FALLBACK=true
SMTP_TIMEOUT_MS=30000
# For many cloud hosts, STARTTLS works more reliably:
# SMTP_PORT=587
# SMTP_SECURE=false

ML_SERVICE_URL=https://smartq-ml.onrender.com

# Comma-separated list of allowed frontend origins for API + Socket.IO.
# Example:
# FRONTEND_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
FRONTEND_ORIGINS=https://smartq-system.vercel.app,http://localhost:3000
